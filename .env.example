# Copiar a .env y ajustar. Variables con prefijo GENIEACS_API_

# NBI de GenieACS (en la misma VM: localhost)
GENIEACS_API_NBI_URL=http://127.0.0.1:7557

# Secreto JWT: generar uno fuerte, p.ej.
#   python -c "import secrets;print(secrets.token_hex(32))"
GENIEACS_API_JWT_SECRET=CAMBIAME

# Duracion del token (minutos)
GENIEACS_API_JWT_EXPIRE_MINUTES=720

# BD de usuarios (SQLite)
GENIEACS_API_DB_PATH=/opt/genieacs-api/genieacs_api.db

# Aplicar cambios al instante (connection request) o esperar al proximo inform
GENIEACS_API_DEFAULT_CONNECTION_REQUEST=true
